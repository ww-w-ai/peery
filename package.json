{
  "name": "peery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "wrangler pages dev ./build/client",
    "deploy": "wrangler pages deploy ./build/client",
    "db:migrate": "wrangler d1 execute peery-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute peery-db --file=./migrations/0001_initial.sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scanner.json",
    "seed": "tsx scripts/seed-top-skills.ts"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0",
    "nanoid": "^5.0.0"
  },
  "optionalDependencies": {
    "@octokit/rest": "^21.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "@react-router/dev": "^7.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^3.100.0"
  }
}
